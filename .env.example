# Copiez ce fichier vers .env et ajustez les valeurs. .env n'est jamais
# versionné (voir .gitignore) : c'est là que vivent les secrets réels.

WAKH_SECRET_KEY=changez-moi-en-production
WAKH_DEBUG=1
WAKH_ALLOWED_HOSTS=*

# Chemin de la base SQLite. Laissez vide pour le défaut (db.sqlite3 à la
# racine du projet) ; en Docker, pointez-le vers le volume monté.
WAKH_DB_PATH=

# Durées de rétention (heures) et tailles max (octets) des files
# d'attente hors-ligne.
WAKH_QUEUE_TTL_HOURS=72
WAKH_QUEUE_MAX_BYTES=15728640
WAKH_TEXT_QUEUE_TTL_HOURS=72
WAKH_TEXT_MESSAGE_MAX_LENGTH=4000
WAKH_MEDIA_QUEUE_TTL_HOURS=72
WAKH_IMAGE_MAX_BYTES=10485760
WAKH_VIDEO_MAX_BYTES=52428800
WAKH_DOCUMENT_MAX_BYTES=31457280
WAKH_DELETE_QUEUE_TTL_HOURS=72
